# Deploy environment variables — copy to .env and fill in real values.
# These are read by docker-compose.yml (${VAR:-default} substitutions).
HUGGING_FACE_HUB_TOKEN=
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
DEEPSEEK_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
QWEN_MODEL=qwen2.5-14b-instruct
MAX_CONVERSATION_TURNS=2
# Hermes tools (opt-in). Set to 1 to enable vendored Hermes tools.
ENABLE_HERMES_TOOLS=0
