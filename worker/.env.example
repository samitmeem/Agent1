# Worker environment variables
# NOTE: the worker reads DATABASE_DSN (see worker/entrypoint.py).
DATABASE_DSN=postgresql://ticket:ticket@postgres:5432/ticketassistant
REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/1
VLLM_BASE_URL=http://vllm:8000/v1
DEEPSEEK_API_KEY=change-me
QWEN_MODEL=qwen2.5-14b-instruct
DEEPSEEK_MODEL=deepseek/deepseek-chat
MAX_CONVERSATION_TURNS=2
ENABLE_PROMPT_CACHE=1
# Hermes tools (opt-in). Set to 1 to enable vendored Hermes tools.
ENABLE_HERMES_TOOLS=0
