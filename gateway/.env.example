# Gateway environment variables
# NOTE: the gateway reads DATABASE_DSN (see gateway/app/config.py).
DATABASE_DSN=postgresql://ticket:ticket@postgres:5432/ticketassistant
PG_MIN_SIZE=5
PG_MAX_SIZE=25
PG_COMMAND_TIMEOUT=15
REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/1
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
VLLM_BASE_URL=http://vllm:8000/v1
DEEPSEEK_API_KEY=
CORS_ORIGINS=http://localhost:5173
